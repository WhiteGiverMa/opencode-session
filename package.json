{
  "name": "opencode-session",
  "version": "0.1.0",
  "description": "Unified session operating system for OpenCode v2: forked /btw asides, subagent micromanagement split-pane TUI, and Code Mode inter-session pager & transcript reader",
  "author": "WhiteGiverMa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WhiteGiverMa/opencode-session.git"
  },
  "homepage": "https://github.com/WhiteGiverMa/opencode-session#readme",
  "bugs": {
    "url": "https://github.com/WhiteGiverMa/opencode-session/issues"
  },
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./dist/server.js",
    "./server": "./dist/server.js",
    "./rpc": "./dist/contract.js",
    "./tui": "./dist/tui.js"
  },
  "files": [
    "dist",
    "server.js",
    "tui.js",
    "rpc.js",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun run scripts/build.ts"
  },
  "dependencies": {
    "effect": "4.1.0",
    "string-width": "7.2.0"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.2.0 <3",
    "@opentui/core": ">=0.8.0",
    "@opentui/solid": ">=0.8.0",
    "solid-js": ">=1.9.15"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/plugin": "2.3.0",
    "@opencode/theme": "2.3.0",
    "@opentui/core": "0.8.4",
    "@opentui/solid": "0.8.4",
    "solid-js": "1.9.17",
    "@types/bun": "1.3.14",
    "@types/node": "24.13.6",
    "typescript": "5.9.3"
  }
}
